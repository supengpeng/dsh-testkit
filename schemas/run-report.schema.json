{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsh-testkit.invalid/schemas/run-report.schema.json",
  "title": "dsh-testkit 运行报告（run.json）",
  "description": "runs/<RUN-ID>/run.json 的结构契约。字段语义以 src/runtime/runlog.ts 为准，新增字段时两边同步。全部可选字段都允许缺省——一次运行不一定启用成本闸门、不一定有 repeat 轮次、不一定能上报用量。",
  "type": "object",
  "required": [
    "runId",
    "startedAt",
    "finishedAt",
    "casesDir",
    "dshVersion",
    "platform",
    "totals",
    "cases"
  ],
  "additionalProperties": false,
  "properties": {
    "runId": {
      "type": "string"
    },
    "startedAt": {
      "type": "string"
    },
    "finishedAt": {
      "type": "string"
    },
    "casesDir": {
      "type": "string"
    },
    "dshVersion": {
      "type": "string"
    },
    "platform": {
      "type": "string"
    },
    "totals": {
      "$ref": "#/$defs/totals"
    },
    "cases": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/caseOutcome"
      }
    },
    "policySnapshot": {
      "$ref": "#/$defs/policySnapshot"
    },
    "selection": {
      "$ref": "#/$defs/selectionRecord"
    },
    "execution": {
      "$ref": "#/$defs/executionRecord"
    },
    "redaction": {
      "$ref": "#/$defs/redactionRecord"
    }
  },
  "$defs": {
    "totals": {
      "description": "RunTotals：五个计数，total = cases.length。",
      "type": "object",
      "required": ["total", "passed", "failed", "skipped", "errored"],
      "additionalProperties": false,
      "properties": {
        "total": {
          "type": "integer"
        },
        "passed": {
          "type": "integer"
        },
        "failed": {
          "type": "integer"
        },
        "skipped": {
          "type": "integer"
        },
        "errored": {
          "type": "integer"
        },
        "inconclusive": {
          "type": "integer",
          "description": "阶段 1 新增（RFC §5「只新增、不删既有字段」）：**含至少一条 `Inconclusive` 断言的 case 数**。口径与同表另五个计数**同计量单位**（`total = cases.length`）——若改记断言数，`total = 五项之和` 这条不变量会对不上（一个 case 里 3 条 inconclusive 断言 ⇒ 总和 > total）。它既不计入 passed 也不计入 failed（设计 §3.3 四态）；既有实现没有该计数，故不进 required，缺省即视为 0。断言级明细在 `cases[].steps[].assertions[].outcome`，不在本表。"
        }
      }
    },
    "caseOutcome": {
      "description": "CaseOutcome：一条用例的完整结果。",
      "type": "object",
      "required": [
        "id",
        "title",
        "kind",
        "verdict",
        "durationMs",
        "steps",
        "notes",
        "releaseFailures",
        "sourceIssue"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "verdict": {
          "enum": ["passed", "failed", "skipped", "errored"]
        },
        "durationMs": {
          "type": "number"
        },
        "skipReason": {
          "type": "string"
        },
        "error": {
          "type": "string"
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/stepOutcome"
          }
        },
        "notes": {
          "description": "夹具取证快照；键集由场景自由决定，故不加约束。",
          "type": "object"
        },
        "releaseFailures": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/releaseFailure"
          }
        },
        "sourceIssue": {
          "type": ["string", "null"]
        },
        "rounds": {
          "description": "每一轮 repeat 的通过情况（repeat > 1 时才记）。",
          "type": "array",
          "items": {
            "type": "boolean"
          }
        },
        "failureCategory": {
          "description": "失败归因；通过 / 跳过时缺省。枚举与 src/runtime/runlog.ts 的 FailureCategory 严格一致。",
          "enum": ["product_bug", "case_bug", "driver_bug", "env", "flaky"]
        },
        "policy": {
          "$ref": "#/$defs/policyDecision"
        },
        "usage": {
          "$ref": "#/$defs/usageRecord"
        },
        "minimalRepro": {
          "type": "string"
        },
        "owner": {
          "description": "负责人（来源 scenario.owner）；覆盖矩阵与 triage 按它路由。",
          "type": "string"
        },
        "fixtures": {
          "description": "本场景引用的 fixture 及其采用情况。",
          "type": "array",
          "items": {
            "$ref": "#/$defs/fixtureRef"
          }
        },
        "cleanup": {
          "$ref": "#/$defs/cleanupRecord"
        },
        "trace": {
          "description": "步骤级 trace。阶段 1 新增：阶段 0 实测确认它被运行期真的写进 run.json，而旧 schema 里没有这个字段（违反 §9.3 纪律 1「没比必须可见」）。**可选**，且**内部结构不声明**（items 是空 schema = 自由形状）：trace 是诊断数据（阶段 / 相对偏移 / 步骤轨迹），内容本质过程性且非确定，把内部结构写进 schema 会给阶段 2 引入大量假阳性差异，而它对「新旧行为是否等价」没有信息量。等价关系由 spec 侧声明为 not-compared（进 uncompared_fields，可见）。",
          "type": "array",
          "items": {}
        }
      }
    },
    "stepOutcome": {
      "description": "StepOutcome：一步的执行结果。",
      "type": "object",
      "required": ["name", "assertions", "durationMs"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "action": {
          "type": "object",
          "required": ["kind", "ok"],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "type": "string"
            },
            "ok": {
              "type": "boolean"
            },
            "detail": {
              "type": "string"
            }
          }
        },
        "assertions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/assertionOutcome"
          }
        },
        "durationMs": {
          "type": "number"
        },
        "notes": {
          "description": "该步的取证增量（相对上一步）。",
          "type": "object"
        }
      }
    },
    "assertionOutcome": {
      "description": "AssertionOutcome：一条断言的判定结果。",
      "type": "object",
      "required": ["assertion", "ok", "actual", "message", "soft"],
      "additionalProperties": false,
      "properties": {
        "assertion": {
          "$ref": "#/$defs/assertion"
        },
        "ok": {
          "type": "boolean"
        },
        "actual": {
          "description": "断言实际取到的值，类型由 ref 指向的数据决定。"
        },
        "message": {
          "type": "string"
        },
        "soft": {
          "type": "boolean"
        },
        "outcome": {
          "description": "断言级四态（设计 §3.3：passed / failed / skipped / inconclusive）。阶段 1 新增——既有实现只有 ok:boolean 两态、RunTotals 也没有对应计数（阶段 0 实测确认），不落 schema 则阶段 2 无法对拍四态。**可选、不进 required**；**字段缺失时用既有的 ok 推导**（缺省 = ok ? \"passed\" : \"failed\"），因此既有报告与旧实现产出的 run.json 仍然合法。它既不计入 passed 也不计入 failed（inconclusive 只进 totals.inconclusive 的 case 级计数）。",
          "enum": ["passed", "failed", "skipped", "inconclusive"]
        }
      }
    },
    "assertion": {
      "description": "Assertion：一行一个断言词；断言词集合归 cases 层维护，这里不锁死 additionalProperties，新增断言词不应让报告 Schema 拒绝。",
      "type": "object",
      "required": ["ref"],
      "properties": {
        "ref": {
          "type": "string"
        },
        "is": {},
        "isNot": {},
        "notIs": {},
        "exists": {
          "type": "boolean"
        },
        "notExists": {
          "type": "boolean"
        },
        "contains": {
          "type": ["string", "array"]
        },
        "notContains": {
          "type": ["string", "array"]
        },
        "matches": {
          "type": "string"
        },
        "atLeast": {
          "type": "number"
        },
        "atMost": {
          "type": "number"
        },
        "length": {
          "type": "integer"
        },
        "lengthAtLeast": {
          "type": "integer"
        },
        "lengthAtMost": {
          "type": "integer"
        },
        "throws": {
          "type": "boolean"
        },
        "soft": {
          "type": "boolean"
        }
      }
    },
    "releaseFailure": {
      "description": "夹具释放时的失败项。",
      "type": "object",
      "required": ["label", "error"],
      "additionalProperties": false,
      "properties": {
        "label": {
          "type": "string"
        },
        "error": {
          "type": "string"
        }
      }
    },
    "policyDecision": {
      "description": "PolicyDecision：成本闸门的判定结果。",
      "type": "object",
      "required": ["allowed", "reason", "cost", "source"],
      "additionalProperties": false,
      "properties": {
        "allowed": {
          "type": "boolean"
        },
        "reason": {
          "type": "string"
        },
        "cost": {
          "enum": ["none", "low", "high"]
        },
        "source": {
          "enum": ["scenario", "driver", "default"]
        }
      }
    },
    "usageRecord": {
      "description": "UsageRecord：一次运行的模型用量记账。",
      "type": "object",
      "required": ["modelCalls", "tokens"],
      "additionalProperties": false,
      "properties": {
        "modelCalls": {
          "type": "number"
        },
        "tokens": {
          "type": "number"
        }
      }
    },
    "policySnapshot": {
      "description": "PolicySnapshot：本次运行采用的闸门快照。",
      "type": "object",
      "required": ["allowModel", "allowLowCost", "sandbox"],
      "additionalProperties": false,
      "properties": {
        "allowModel": {
          "type": "boolean"
        },
        "allowLowCost": {
          "type": "boolean"
        },
        "sandbox": {
          "description": "沙箱策略快照；键集由 ExecutionPolicy.sandbox 决定。",
          "type": "object"
        }
      }
    },
    "selectionRecord": {
      "description": "SelectionRecord：增量测试选择为什么只跑了这些。",
      "type": "object",
      "required": ["mode", "detail", "matched"],
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string"
        },
        "detail": {
          "type": "string"
        },
        "matched": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "executionRecord": {
      "description": "ExecutionRecord：这次是串行还是并发、并发度多少。",
      "type": "object",
      "required": ["parallel", "limit", "safe", "exclusive"],
      "additionalProperties": false,
      "properties": {
        "parallel": {
          "enum": ["off", "limited"]
        },
        "limit": {
          "type": "number"
        },
        "safe": {
          "type": "integer"
        },
        "exclusive": {
          "type": "integer"
        }
      }
    },
    "fixtureRef": {
      "description": "FixtureRef：引用了哪份夹具、来自哪里、为什么没用上。",
      "type": "object",
      "required": ["name", "source"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "dshVersion": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "cleanupRecord": {
      "description": "CleanupRecord：释放了什么、有没有残留。",
      "type": "object",
      "required": ["released", "leftovers"],
      "additionalProperties": false,
      "properties": {
        "released": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "leftovers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "redactionRecord": {
      "description": "RedactionRecord：脱敏了几处、分布在哪（只记位置与类型，绝不记原文）。",
      "type": "object",
      "required": ["count", "findings"],
      "additionalProperties": false,
      "properties": {
        "count": {
          "type": "integer"
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "kind"],
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string"
              },
              "kind": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
