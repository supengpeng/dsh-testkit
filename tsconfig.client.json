{
  "//": "client 半（浏览器侧）仅做类型检查；真正产物由 scripts/build-client.mjs（esbuild）打包成 lib/client.js。",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": [],
    "jsx": "react-jsx",
    "noEmit": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/client/**/*.ts", "src/client/**/*.tsx"]
}
