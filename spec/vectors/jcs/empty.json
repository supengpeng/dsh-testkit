{
  "domain": "jcs",
  "covers": [
    "empty"
  ],
  "note": "空对象 / 空数组 / 空串：显式的 {} 与 []，没有空白",
  "source": "src/attest/tools/make-jcs-vectors.mjs（oracle = JS 的 JSON.stringify + 默认键排序；RFC 8785 §3.2.2.3 把数字形态定义为 ECMAScript Number::toString）",
  "cases": [
    {
      "id": "empty-01",
      "covers": "empty",
      "note": "空对象",
      "input_json": "{}",
      "expected_hex": "7b7d",
      "expected_text": "{}"
    },
    {
      "id": "empty-02",
      "covers": "empty",
      "note": "空数组",
      "input_json": "[]",
      "expected_hex": "5b5d",
      "expected_text": "[]"
    },
    {
      "id": "empty-03",
      "covers": "empty",
      "note": "对象里嵌空对象与空数组",
      "input_json": "{\"a\":{},\"b\":[]}",
      "expected_hex": "7b2261223a7b7d2c2262223a5b5d7d",
      "expected_text": "{\"a\":{},\"b\":[]}"
    },
    {
      "id": "empty-04",
      "covers": "empty",
      "note": "空字符串",
      "input_json": "\"\"",
      "expected_hex": "2222",
      "expected_text": "\"\""
    },
    {
      "id": "empty-05",
      "covers": "empty",
      "note": "数组里嵌空数组与空对象",
      "input_json": "[[],{}]",
      "expected_hex": "5b5b5d2c7b7d5d",
      "expected_text": "[[],{}]"
    },
    {
      "id": "empty-06",
      "covers": "empty",
      "note": "两个空对象",
      "input_json": "[{},{}]",
      "expected_hex": "5b7b7d2c7b7d5d",
      "expected_text": "[{},{}]"
    },
    {
      "id": "empty-07",
      "covers": "empty",
      "note": "空键 + 空值",
      "input_json": "{\"\":\"\"}",
      "expected_hex": "7b22223a22227d",
      "expected_text": "{\"\":\"\"}"
    }
  ]
}
