{
  "name": "@supengpeng/dsh-testkit",
  "version": "0.1.0",
  "description": "DSH 测试插件：把 issue 提炼为可复现的测试场景数据（cases/*.yaml），按场景 kind 驱动宿主行为、出报告，并可导出为 CI 用例",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./schemas/run-report.schema.json": "./schemas/run-report.schema.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "bin",
    "src",
    "cases",
    "docs",
    "schemas",
    "dsh",
    "README.md",
    "SECURITY.md",
    "fixtures",
    "registry",
    "templates"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "test",
    "testkit",
    "scenario",
    "fixture",
    "regression"
  ],
  "license": "MIT",
  "bin": {
    "dsh-testkit": "./bin/dsh-testkit.mjs"
  },
  "engines": {
    "node": ">=22.19"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.2.0-rc.2"
    },
    "compatibility": {
      "dshReleases": {
        "0.2.0-rc.2": "compatible"
      },
      "profiles": [
        "desktop",
        "web"
      ]
    },
    "bundle": {
      "patch": "./dsh/cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "dependencies": {
    "yaml": "^2.6.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.4",
    "@deepseek-ai/dsh-llm": ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-session": ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-system-prompt": ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": ">=0.2.0-rc.2",
    "@deepseek-ai/schemastery": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": { "optional": true },
    "@deepseek-ai/dsh-llm": { "optional": true },
    "@deepseek-ai/dsh-session": { "optional": true },
    "@deepseek-ai/dsh-system-prompt": { "optional": true },
    "@deepseek-ai/dsh-tools": { "optional": true },
    "@deepseek-ai/schemastery": { "optional": true }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-llm": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-session": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-system-prompt": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "^0.2.0-rc.2",
    "@deepseek-ai/schemastery": "^3.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('lib',{recursive:true,force:true})\"",
    "build": "node -e \"require('node:fs').rmSync('lib',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "build:client": "node scripts/build-client.mjs",
    "build:all": "node -e \"require('node:fs').rmSync('lib',{recursive:true,force:true})\" && tsc -p tsconfig.json && node scripts/build-client.mjs",
    "prepare": "node scripts/build-lock.mjs && node scripts/build-client.mjs",
    "typecheck:host": "tsc -p tsconfig.json --noEmit",
    "typecheck:client": "tsc -p tsconfig.client.json --noEmit",
    "verify:cases": "node scripts/verify-cases.mjs",
    "verify:docs": "node scripts/verify-docs.mjs",
    "verify:adapter": "node scripts/check-adapter-boundary.mjs",
    "verify:pack": "node scripts/check-pack-files.mjs",
    "verify:git-install": "node scripts/check-git-installable.mjs",
    "verify:fixtures": "node scripts/verify-fixtures.mjs",
    "verify:registry": "node scripts/verify-registry.mjs",
    "verify:secrets": "node scripts/check-secrets.mjs",
    "export:ci": "node scripts/export-scenarios.mjs",
    "test": "node --test \"tests/*.test.mjs\"",
    "test:contracts": "node --test \"tests/contracts/*.test.mjs\"",
    "gate": "node -e \"require('node:fs').rmSync('lib',{recursive:true,force:true})\" && tsc -p tsconfig.json && node scripts/build-client.mjs && node scripts/verify-cases.mjs && node scripts/verify-docs.mjs && node scripts/check-adapter-boundary.mjs && node scripts/check-pack-files.mjs && node scripts/check-git-installable.mjs && node scripts/verify-fixtures.mjs && node scripts/verify-registry.mjs && node scripts/check-secrets.mjs && node --test \"tests/contracts/*.test.mjs\" && node --test \"tests/*.test.mjs\" && node scripts/export-scenarios.mjs && node --test export/scenarios.test.mjs && tsc -p tsconfig.client.json --noEmit"
  }
}
